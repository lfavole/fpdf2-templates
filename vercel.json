{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "python3 webapp/build.py",
    "outputDirectory": "static",
    "rewrites": [
        {
            "source": "/static/(.*)",
            "destination": "/$1"
        },
        {
            "source": "/(.*)",
            "destination": "api/app.py"
        }
    ]
}
